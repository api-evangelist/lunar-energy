          "request": {
            "name": "Opt Out Of Flex Dispatch",
            "description": {
              "content": "Opt a participant out of a flex dispatch. Participants may be\nidentified by site ID or participant ID. Idempotent — repeat opt-outs\nreturn the original opt-out details.\n",
              "type": "text/plain"
            },
            "url": {
