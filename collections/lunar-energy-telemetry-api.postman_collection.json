          "name": "Get Counterfactual Telemetry",
          "request": {
            "name": "Get Counterfactual Telemetry",
            "description": {
              "content": "Counterfactual telemetry — what the device would have done if it had\nnot been smartly controlled. Availability depends on the\ncounterfactuals enabled for your partner account.\n",
              "type": "text/plain"
