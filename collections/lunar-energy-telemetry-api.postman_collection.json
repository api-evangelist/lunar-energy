        {
          "id": "05bfb643-eb8c-4b85-9507-d02cd03e148b",
          "name": "Get Device Telemetry",
          "request": {
            "name": "Get Device Telemetry",
            "description": {
              "content": "Get time-bucketed telemetry for a device or sensor. `synthId` can be\na device ID or a sensor ID from the site topology. Supported device\nkinds: `inverter`, `battery_pack`, `PV`, `EV`, `meter`,\n`load_control_relay`. Include `energy_Wh_increment` and\n`energy_Wh_decrement` by passing `include=default,energy`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "devices",
                ":synthId",
                "telemetry"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated set of telemetry fields. `energy` is opt-in."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>"
                },
                {
                  "disabled": false,
                  "key": "bucket",
                  "value": "<string>",
                  "description": "Time-bucket size (e.g. `PT1H`)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "synthId",
                  "description": "(Required) A device ID or a sensor ID from the site topology."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
