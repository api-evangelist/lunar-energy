      "item": [
        {
          "id": "b1352309-68ac-4a7e-99d6-82c9a7298f3f",
          "name": "Get Device Operation Mode",
          "request": {
            "name": "Get Device Operation Mode",
            "description": {
              "content": "Get the current Gridshare operation mode of a device. Valid modes:\n- `Simple` — follow the simplest plan possible for the device kind\n- `Schedule` — follow a periodical plan\n- `Smart` — AI-optimized smart plan\n- `Unknown` — operation mode cannot be determined\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "devices",
                ":synthId",
                "operationmode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "synthId",
                  "description": "(Required) A device ID or a sensor ID from the site topology."
