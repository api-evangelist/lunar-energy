      "item": [
        {
          "id": "e67363a6-bcd0-4456-9ad5-f737f6a3d83d",
          "name": "Create Prognosis Diff Request",
          "request": {
            "name": "Create Prognosis Diff Request",
            "description": {
              "content": "Request a modification to a prognosis profile. Allows charging or\ndischarging to the network in a coordinated manner by submitting a\ndifferential profile over the original prognosis. Asynchronous —\npoll the Diff Request endpoint for status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "prognoses",
                ":prognosisId",
                "prognosisdiffrequests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "prognosisId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prognosisDiffRequestId\": \"<string>\",\n  \"prognosisId\": \"<string>\",\n  \"diffProfile\": [\n    {\n      \"start\": \"<dateTime>\",\n      \"end\": \"<dateTime>\",\n      \"deltaPower_W\": \"<number>\"\n    },\n    {\n      \"start\": \"<dateTime>\",\n      \"end\": \"<dateTime>\",\n      \"deltaPower_W\": \"<number>\"\n    }\n  ],\n  \"status\": \"<string>\",\n  \"offer\": {\n    \"feasiblePower_W\": \"<number>\",\n    \"price\": \"<number>\",\n    \"currency\": \"<string>\"\n  }\n}",
